% jake-style.sty: second look for the same CV content, modelled on
% "Jake's Resume" (github.com/jakegut/resume, MIT), the one-page LaTeX
% template that r/cscareerquestions and r/EngineeringResumes recommend most
% for new-grad software roles.
% It defines the same commands as cv-style.sty (\cvheader, \cvjob, \cvsub,
% \cventry, \cvskill, \cvlink), so any CV .tex file can switch look by
% changing one \usepackage line.
% ATS-safe like cv-style: one column, real text for every glyph
% (glyphtounicode + cmap), no ligatures, no hyphenation, no icons.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jake-style}[2026/10/19 CV style, Jake's Resume look]

\input{glyphtounicode}
\pdfgentounicode=1
\RequirePackage{cmap}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}% vector Latin Modern: the Computer Modern look of the original
\RequirePackage{microtype}
\DisableLigatures[f]{encoding = *, family = *}
\hyphenpenalty=10000
\exhyphenpenalty=10000

\RequirePackage[a4paper,top=0.4in,bottom=0.4in,left=0.5in,right=0.5in]{geometry}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage[hidelinks,pdfusetitle]{hyperref}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\raggedright
\urlstyle{same}

% Section heading: rule underneath as in Jake's template, but real uppercase
% bold text instead of small caps, so parsers see the heading as a heading.
\titleformat{\section}{\bfseries\raggedright\large}{}{0em}{\MakeUppercase}[\titlerule]
\titlespacing*{\section}{0pt}{7pt}{3pt}

\setlist[itemize]{leftmargin=0.17in,label={\textbullet},nosep,topsep=1pt,itemsep=0pt,before=\small}

% \cvheader{Name}{Headline}
\newcommand{\cvheader}[2]{%
  \begin{center}
    {\Huge\scshape #1}\\[3pt]
    {\normalsize #2}\\[2pt]
    \small +20 114 250 5042 $|$
    \href{mailto:abdelrahman.khalifa.gad@gmail.com}{\underline{abdelrahman.khalifa.gad@gmail.com}} $|$
    Cairo, Egypt\\[1pt]
    \href{https://www.linkedin.com/in/abd002}{\underline{linkedin.com/in/abd002}} $|$
    \href{https://github.com/Abd002}{\underline{github.com/Abd002}} $|$
    \href{https://codeforces.com/profile/_Khalifa}{\underline{codeforces.com/profile/\_Khalifa}}
  \end{center}
  \vspace{-8pt}}

% \cvjob{Job title}{Company}{Dates}: bold company with dates on the right,
% italic job title on the line below (Jake's \resumeSubheading). Unlike the
% original's tabular, the date is \hfill on the same text line, so parsers read
% company and date together (the tabular version lost jobs in OpenResume).
\newcommand{\cvjob}[3]{%
  \par\vspace{3pt}%
  \textbf{#2} \hfill #3\par
  {\small\itshape #1}\par\vspace{1pt}}

% \cventry{Title}{Dates}: one bold line with dates on the right.
\newcommand{\cventry}[2]{%
  \par\vspace{3pt}%
  {\small\textbf{#1}} \hfill {\small #2}\par\vspace{1pt}}

% \cvsub{small italic line, e.g. project name and links}
\newcommand{\cvsub}[1]{{\small\itshape #1}\par}

% \cvskill{Label}{items}
\newcommand{\cvskill}[2]{{\small\textbf{#1}: #2}\par\vspace{1pt}}

% \cvlink{url}{text}: underlined link text, as in the original template.
\newcommand{\cvlink}[2]{\href{#1}{\underline{#2}}}
